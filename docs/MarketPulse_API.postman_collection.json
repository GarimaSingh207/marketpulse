{
  "info": {
    "_postman_id": "marketpulse-api-collection",
    "name": "MarketPulse API",
    "description": "Complete Postman Collection for MarketPulse Financial Analytics Platform API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Server Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Database Connection Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/db-check",
              "host": ["{{baseUrl}}"],
              "path": ["api", "db-check"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get User Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Management (RBAC)",
      "item": [
        {
          "name": "Get All Users (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            }
          }
        },
        {
          "name": "Delete User by ID (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "user_id_here"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Portfolios & Holdings",
      "item": [
        {
          "name": "Create Portfolio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tech Growth Portfolio\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/portfolios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolios"]
            }
          }
        },
        {
          "name": "Get User Portfolios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/portfolios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolios"]
            }
          }
        },
        {
          "name": "Delete Portfolio",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/portfolios/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolios", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "portfolio_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Add Holding to Portfolio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"AAPL\",\n  \"quantity\": 10,\n  \"averagePrice\": 150.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/portfolios/:portfolioId/holdings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolios", ":portfolioId", "holdings"],
              "variable": [
                {
                  "key": "portfolioId",
                  "value": "portfolio_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Holding",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/holdings/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "holdings", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "holding_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Create Transaction (BUY/SELL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"BUY\",\n  \"quantity\": 5,\n  \"price\": 160.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/holdings/:holdingId/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "holdings", ":holdingId", "transactions"],
              "variable": [
                {
                  "key": "holdingId",
                  "value": "holding_id_here"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Market Data & Valuation",
      "item": [
        {
          "name": "Get Stock Price Quote",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/market/price/:symbol",
              "host": ["{{baseUrl}}"],
              "path": ["api", "market", "price", ":symbol"],
              "variable": [
                {
                  "key": "symbol",
                  "value": "AAPL"
                }
              ]
            }
          }
        },
        {
          "name": "Get Real-Time Portfolio Value",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/portfolio/value/:portfolioId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolio", "value", ":portfolioId"],
              "variable": [
                {
                  "key": "portfolioId",
                  "value": "portfolio_id_here"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
