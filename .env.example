# ==============================================================================
# MarketPulse — Root Environment Variables Template
# Copy this file to .env before running docker compose up or docker compose -f docker-compose.production.yml up
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=marketpulse

# ------------------------------------------------------------------------------
# 2. Backend API Service Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Database URL used inside Docker containers (service name 'postgres')
DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/marketpulse?schema=public

# Redis URL used inside Docker containers (service name 'redis')
REDIS_URL=redis://redis:6379

# Cryptographically random JWT secret (change for production deployment)
JWT_SECRET=marketpulse_jwt_secret_key_2026_production

# Finnhub Stock Market API key (get free key from https://finnhub.io)
MARKET_API_KEY=your_finnhub_api_key_here

# Allowed CORS Origin for security (set to EC2 public IP or domain in production)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Frontend Web Application Build Arguments
# ------------------------------------------------------------------------------
# Leave empty for production deployments behind Nginx (uses relative paths /api & window.location.origin for WebSocket)
VITE_API_URL=
VITE_SOCKET_URL=
