# ==============================================================================
# MarketPulse Backend — Production Environment Variables Template
# Copy this file to .env on your production server or pass via container environment.
# NEVER commit the actual .env file with real secrets!
# ==============================================================================

# Application Port & Node Environment
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL 16)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://marketpulse_admin:CHANGE_THIS_SECURE_PASSWORD@postgres:5432/marketpulse_prod?schema=public

# Redis Connection (Redis 7)
REDIS_URL=redis://redis:6379

# JSON Web Token Secret
# Generate a cryptographically secure random string (e.g. openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_32_CHARS_MIN

# External Financial Market API Key (Finnhub)
# Sign up at https://finnhub.io/ to obtain your production API key
MARKET_API_KEY=your_production_finnhub_api_key_here

# Allowed CORS Origin
# Must match your production frontend domain or EC2 public IP/domain
CORS_ORIGIN=http://your-ec2-public-ip-or-domain
