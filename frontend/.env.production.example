# ==============================================================================
# MarketPulse Frontend — Production Environment Variables Template
# Copy this file to .env on your production server or pass as Docker build args.
# Note: VITE_ variables are embedded into static JS bundles at build time!
# ==============================================================================

# Backend REST API URL (EC2 Public IP, Domain, or ALB)
VITE_API_URL=http://your-ec2-public-ip-or-domain:5000

# Backend Socket.IO Server URL
VITE_SOCKET_URL=http://your-ec2-public-ip-or-domain:5000
